---
import Layout from "../layouts/Layout.astro";

// ニュース記事データ
const newsArticles = [
  {
    title: "【熊本地震】願いを届けるデジタル絵馬を公開しました",
    url: "https://nsf.stki.org/ema",
    date: "2026.08.15",
    category: "お知らせ",
    badgeClass: "badge-info",
    hasLink: true,
    summary: "被災地の一日も早い復興を願い、デジタル絵馬ページを公開いたしました。皆さまからの温かいメッセージをお待ちしております。"
  },
  {
    title: "【令和8年熊本地震 支援メンバー募集】当団体の対応および支援活動について",
    url: "/earthquake-notice",
    date: "2026.07.28",
    category: "緊急募集",
    badgeClass: "badge-urgent",
    hasLink: true,
    summary: "本日発生いたしました地震につきまして、当団体では学生・若者を中心とした支援募金プロジェクトの立ち上げを進めております。現在、全国で支援活動にご協力いただける中学生・高校生・大学生等のメンバーを緊急募集しています。"
  },
  {
    title: "【メンバー募集】広報・災害支援など各種プロジェクトの募集情報を更新しました",
    url: "/recruitment",
    date: "2026.07.30",
    category: "募集",
    badgeClass: "badge-recruitment",
    hasLink: true,
    summary: "日本若者防災復興協会（JYRAC）では、全国の中学生・高校生・大学生を中心とした若者メンバーを大募集しています。最新の募集要項はこちらからご確認いただけます。"
  },
{
    title: "特定非営利活動法人 日本若者防災復興協会 正式設立（登記完了）のお知らせ",
    url: "#",
    date: "2026.06.21",
    category: "お知らせ",
    badgeClass: "badge-info",
    hasLink: false,
    summary: "特定非営利活動法人 日本若者防災復興協会は、法務局での設立登記手続きが完了し、正式に法人として設立いたしました。また、初期運用コストを抑えるため、学生団体の共有ドメインサービスを運営する協力団体「TRANs」の許可を得て、そのドメイン「stki.org」のサブドメインである「jyrac.stki.org」を当団体の公式ウェブサイト・公式ドメインとして無償で借り受け、運用しております。"
  },
  {
    title: "特定非営利活動法人 日本若者防災復興協会 設立（認証されました）のお知らせ",
    url: "#",
    date: "2026.06.17",
    category: "お知らせ",
    badgeClass: "badge-info",
    hasLink: false,
    summary: "東京都より特定非営利活動法人 日本若者防災復興協会の設立が認証されましたことをご報告いたします。"
  }
];
---

<Layout title="ホーム | JYRAC 日本若者防災復興協会" currentTab="news">
  <div class="news-page-container">
    
    <header class="news-header">
      <span class="sub-title">JYRAC NEWS & TOPICS</span>
      <h1 class="main-title">お知らせ・最新情報</h1>
      <p class="header-desc">特定非営利活動法人 日本若者防災復興協会の最新情報をお届けします。</p>
    </header>

    <div class="news-list">
      {newsArticles.map((article) => (
        article.hasLink ? (
          /* 【リンクあり】カード（ホバーでふわっと浮く） */
          <div class={`news-card ${article.badgeClass === 'badge-urgent' ? 'card-urgent' : 'card-link'}`}>
            <div class="card-header">
              <span class={`badge ${article.badgeClass}`}>{article.category}</span>
              <span class="news-date">{article.date}</span>
            </div>
            <h2 class="card-title">
              <a href={article.url}>{article.title}</a>
            </h2>
            <p class="card-summary">{article.summary}</p>
            <div class="card-footer">
              <a href={article.url} class="detail-link">
                詳細ページを見る ➔
              </a>
            </div>
          </div>
        ) : (
          /* 【通常・リンクなし】カード */
          <div class="news-card card-normal">
            <div class="card-header">
              <span class={`badge ${article.badgeClass}`}>{article.category}</span>
              <span class="news-date">{article.date}</span>
            </div>
            <h2 class="card-title-normal">{article.title}</h2>
            <p class="card-summary">{article.summary}</p>
          </div>
        )
      ))}
    </div>

  </div>
</Layout>

<style>
  /* JYRAC完全対応・崩れ防止専用CSS */
  .news-page-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px 0 40px 0;
    box-sizing: border-box;
  }

  /* ヘッダー */
  .news-header {
    text-align: center;
    padding-bottom: 24px;
    margin-bottom: 32px;
    border-bottom: 2px solid rgba(0, 154, 166, 0.15);
  }

  .sub-title {
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    color: #009aa6;
    background: rgba(0, 154, 166, 0.08);
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .main-title {
    font-size: 26px;
    font-weight: 900;
    color: #002b54;
    margin: 6px 0;
    line-height: 1.3;
  }

  .header-desc {
    font-size: 13px;
    color: #5b6779;
    margin: 0;
  }

  /* ニュースカード一覧 */
  .news-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* 共通カードスタイル ＆ ふわっと浮くアニメーション設定 */
  .news-card {
    border-radius: 16px;
    padding: 24px;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), 
                box-shadow 0.3s cubic-bezier(0.165, 0.84, 0.44, 1), 
                border-color 0.3s ease;
    will-change: transform, box-shadow;
  }

  /* 緊急カード（赤） */
  .card-urgent {
    background: #ffffff;
    border: 2px solid #e53e3e;
    box-shadow: 0 4px 12px rgba(229, 62, 62, 0.08);
  }

  .card-urgent:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(229, 62, 62, 0.18);
    border-color: #c53030;
  }

  /* リンク付き通常カード（青枠ホバー） */
  .card-link {
    background: #ffffff;
    border: 1.5px solid #009aa6;
    box-shadow: 0 4px 12px rgba(0, 154, 166, 0.08);
  }

  .card-link:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 24px rgba(0, 154, 166, 0.18);
    border-color: #002b54;
  }

  /* 通常カード（グレー・リンクなし） */
  .card-normal {
    background: #f8fafc;
    border: 1px solid rgba(0, 154, 166, 0.15);
    box-shadow: 0 2px 8px rgba(0, 43, 84, 0.02);
  }

  .card-normal:hover {
    transform: translateY(-4px);
    background: #ffffff;
    border-color: rgba(0, 154, 166, 0.4);
    box-shadow: 0 8px 20px rgba(0, 43, 84, 0.08);
  }

  /* カードヘッダー (バッジ & 日付) */
  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  /* ★【グラデーションバッジ共通スタイル】★ */
  .badge {
    font-size: 11px;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.04em;
    color: #ffffff;
    display: inline-block;
    line-height: 1.2;
  }

  /* 緊急募集：赤〜オレンジの立体グラデーション */
  .badge-urgent {
    background: linear-gradient(135deg, #ff4b4b 0%, #c53030 100%);
    box-shadow: 0 2px 8px rgba(229, 62, 62, 0.35);
  }

  /* 募集：エメラルド〜ターコイズのグラデーション */
  .badge-recruitment {
    background: linear-gradient(135deg, #00d2e0 0%, #008f9b 100%);
    box-shadow: 0 2px 8px rgba(0, 180, 197, 0.35);
  }

  /* お知らせ：ディープネイビー〜ブルーのグラデーション */
  .badge-info {
    background: linear-gradient(135deg, #0a4f8f 0%, #002b54 100%);
    box-shadow: 0 2px 8px rgba(0, 43, 84, 0.25);
  }

  .news-date {
    font-size: 13px;
    font-weight: 700;
    color: #718096;
  }

  /* タイトル */
  .card-title {
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 10px 0;
    line-height: 1.4;
  }

  .card-title a {
    color: #002b54;
    text-decoration: none;
    transition: color 0.2s;
  }

  .card-title a:hover {
    color: #009aa6;
    text-decoration: underline;
  }

  .card-title-normal {
    font-size: 16px;
    font-weight: 800;
    color: #2d3748;
    margin: 0 0 10px 0;
    line-height: 1.4;
  }

  /* サマリー文章 */
  .card-summary {
    font-size: 14px;
    color: #4a5568;
    line-height: 1.6;
    margin: 0;
  }

  /* フッターリンク */
  .card-footer {
    margin-top: 16px;
    text-align: right;
  }

  .detail-link {
    display: inline-block;
    font-size: 13px;
    font-weight: 800;
    color: #009aa6;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .detail-link:hover {
    opacity: 0.8;
    text-decoration: underline;
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .news-card {
      padding: 18px;
    }
    .main-title {
      font-size: 20px;
    }
    .card-title {
      font-size: 16px;
    }
  }
</style>
