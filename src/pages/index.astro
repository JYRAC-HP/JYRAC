---
import Layout from "../layouts/Layout.astro";

// ニュース記事データ（熊本地震のみ詳細リンクあり）
const newsArticles = [
  {
    title: "【令和8年熊本地震 支援メンバー募集】当団体の対応および支援活動について",
    url: "/earthquake-notice",
    date: "2026.07.28",
    category: "緊急募集",
    hasLink: true,
    summary: "本日発生いたしました地震につきまして、当団体では学生・若者を中心とした支援募金プロジェクトの立ち上げを進めております。現在、全国で支援活動にご協力いただける中学生・高校生・大学生等のメンバーを緊急募集しています。"
  },
  {
    title: "特定非営利活動法人 日本若者防災復興協会 正式設立（登記完了）のお知らせ",
    url: "#",
    date: "2026.06.21",
    category: "お知らせ",
    hasLink: false,
    summary: "特定非営利活動法人 日本若者防災復興協会は、法務局での設立登記手続きが完了し、正式に法人として設立いたしました。"
  },
  {
    title: "特定非営利活動法人 日本若者防災復興協会 設立（認証されました）のお知らせ",
    url: "#",
    date: "2026.06.17",
    category: "お知らせ",
    hasLink: false,
    summary: "東京都より特定非営利活動法人 日本若者防災復興協会の設立が認証されましたことをご報告いたします。"
  }
];
---

<Layout title="ホーム | JYRAC 日本若者防災復興協会" activeKey="home" showSplash>

  <main class="max-w-4xl mx-auto px-4 py-10 space-y-12">
    
    <header class="border-b border-slate-200 pb-8 text-center space-y-3">
      <p class="text-xs md:text-sm font-bold text-blue-600 tracking-wider">特定非営利活動法人 日本若者防災復興協会（JYRAC）</p>
      <h1 class="text-2xl md:text-4xl font-black text-slate-900 leading-tight">
        お知らせ・最新情報
      </h1>
    </header>

    <section class="space-y-6">
      <div class="space-y-4">
        {newsArticles.map((article) => (
          article.hasLink ? (
            <article class="bg-white border-2 border-red-200 rounded-2xl p-6 shadow-sm hover:border-red-500 transition duration-150 space-y-3">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="bg-red-600 text-white text-xs font-bold px-2.5 py-1 rounded">
                  {article.category}
                </span>
                <time class="text-xs md:text-sm text-slate-500 font-bold">{article.date}</time>
              </div>
              <h2 class="text-lg md:text-xl font-bold text-slate-950 leading-snug">
                <a href={article.url} class="hover:text-red-600 transition duration-150">
                  {article.title}
                </a>
              </h2>
              <p class="text-sm text-slate-600 leading-relaxed font-medium">
                {article.summary}
              </p>
              <div class="pt-2">
                <a href={article.url} class="inline-flex items-center text-xs md:text-sm font-bold text-red-600 hover:underline gap-1">
                  詳細・募集要項を見る ➔
                </a>
              </div>
            </article>
          ) : (
            <article class="bg-slate-50 border border-slate-200 rounded-2xl p-6 space-y-2">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="bg-slate-200 text-slate-700 text-xs font-bold px-2.5 py-0.5 rounded">
                  {article.category}
                </span>
                <time class="text-xs md:text-sm text-slate-400 font-bold">{article.date}</time>
              </div>
              <h2 class="text-base md:text-lg font-bold text-slate-800 leading-snug">
                {article.title}
              </h2>
              <p class="text-xs md:text-sm text-slate-600 leading-relaxed">
                {article.summary}
              </p>
            </article>
          )
        ))}
      </div>
    </section>

  </main>

</Layout>
