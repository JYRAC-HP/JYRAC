---
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメーターを取得 (プロトコルをhttpsに整形)
const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];

// 言語に応じたクエリパラメータ（リンク維持用）
const langParam = currentLang === 'en' ? '?lang=en' : '';
---

<Layout 
  title={currentLang === 'en' ? '2026 Kumamoto Earthquake Relief Members Wanted | JYRAC' : '令和8年熊本地震 支援メンバー募集 | JYRAC'} 
  currentTab="news"
>
  <div class="notice-container">
    <div class="back-link-wrapper">
      <a href={`/${langParam}`} class="back-link">
        {currentLang === 'en' ? '➔ Back to Top' : '➔ トップページに戻る'}
      </a>
    </div>

    <header class="notice-header">
      <div class="meta-info">
        <span class="badge-urgent">
          {currentLang === 'en' ? 'URGENT' : '緊急募集'}
        </span>
        <span class="notice-date">2026.07.28</span>
      </div>
      <h1 class="notice-title">
        {currentLang === 'en'
          ? '[2026 Kumamoto Earthquake: Relief Members Wanted]'
          : '【令和8年熊本地震 支援メンバー募集】'}
      </h1>
    </header>

    <div class="notice-body">
      <p class="sympathy-box">
        {currentLang === 'en'
          ? 'We express our deepest sympathies to all those affected by the 2026 Kumamoto Earthquake.'
          : 'このたびの令和8年熊本地震により被災された皆様に、心よりお見舞い申し上げます。'}
      </p>

      <div class="notice-image-card">
        <img 
          src="/kumamoto_image.jpg" 
          alt={currentLang === 'en' ? '2026 Kumamoto Earthquake Relief Poster' : '令和8年熊本地震 支援活動 ポスター'} 
        />
      </div>

      <p>
        {currentLang === 'en'
          ? 'The Japan Youth Resilience Action Consortium (JYRAC) is launching a youth- and student-led fundraising relief project for the 2026 Kumamoto Earthquake.'
          : '特定非営利活動法人 日本若者防災復興協会（JYRAC）では、令和8年熊本地震において若者・学生を中心とした支援募金プロジェクトの立ち上げを進めております。'}
      </p>

      <p>
        {currentLang === 'en' ? (
          <>We are urgently seeking <strong>youth members (junior high, high school, university students, etc.)</strong> across Japan to cooperate in relief activities.</>
        ) : (
          <>現在、全国で支援活動にご協力いただける<strong>中学生・高校生・大学生等の若者メンバー</strong>を緊急募集しています。</>
        )}
      </p>

      <div class="info-block">
        <h2>
          {currentLang === 'en' ? '■ Main Activities' : '■ 主な活動内容'}
        </h2>
        <ul>
          {currentLang === 'en' ? (
            <>
              <li>Planning and conducting in-school fundraising in cooperation with schools and student councils</li>
              <li>Planning and operating street fundraising activities in various regions</li>
              <li>Coordination and installation of fixed donation boxes</li>
              <li>Public relations, SNS dissemination, and design creation</li>
              <li>Operations, regional partnership, and coordination tasks, etc.</li>
            </>
          ) : (
            <>
              <li>学校・生徒会等と連携した校内募金の企画・実施</li>
              <li>各地域での街頭募金活動の企画・運営</li>
              <li>設置型募金箱の導入・調整</li>
              <li>広報・SNS発信・デザイン作成</li>
              <li>運営・地域連携・調整業務 など</li>
            </>
          )}
        </ul>
      </div>

      <p>
        {currentLang === 'en'
          ? 'Activities will mainly proceed through online meetings, so you can participate from anywhere in Japan. Prior experience in disaster management or volunteering is not required.'
          : '活動はオンラインでの打ち合わせを中心に進めるため、全国どこからでもご参加いただけます。防災活動やボランティアの経験は問いません。'}
      </p>

      <div class="info-block highlight-block">
        <h2>
          {currentLang === 'en' ? '■ Target & How to Join' : '■ 対象・参加方法'}
        </h2>
        
        <div class="detail-item">
          <strong>{currentLang === 'en' ? '【Target】' : '【対象】'}</strong>
          <p>{currentLang === 'en' ? 'Junior high, high school, university students, and youth generation' : '中学生・高校生・大学生・若者世代'}</p>
        </div>

        <div class="detail-item">
          <strong>{currentLang === 'en' ? '【Contact Person】' : '【担当窓口】'}</strong>
          <p>{currentLang === 'en' ? 'PR Director: Takaesu' : '広報局長 高江洲'}</p>
        </div>

        <div class="detail-item">
          <strong>{currentLang === 'en' ? '【Participation & Inquiries】' : '【参加・お問い合わせ方法】'}</strong>
          <p>
            {currentLang === 'en'
              ? 'If you would like to participate in relief activities or have any questions, please feel free to contact us via the email address below or through our contact points (Attn: PR Director Takaesu).'
              : '支援活動への参加希望やご相談は、下記メールアドレスまたは各種連絡先（担当：広報局長 高江洲）までお気軽にお問い合わせください。'}
          </p>
        </div>

        <div class="btn-wrapper">
          <a 
            href={`mailto:jyrac.pr@gmail.com?subject=${currentLang === 'en' ? encodeURIComponent('【Relief Member Application】Attn: PR Director Takaesu') : '【支援メンバー応募】広報局長%20高江洲宛'}`} 
            class="contact-btn"
          >
            {currentLang === 'en' 
              ? 'Inquire via Email (Attn: PR Director Takaesu)' 
              : 'メールで問い合わせ（担当：広報局長 高江洲）'}
          </a>
        </div>
      </div>

      <p>
        {currentLang === 'en'
          ? 'Even if one person’s power is small, when youth across the nation join hands, it becomes a powerful force of support.'
          : '一人の力は小さくても、全国の若者が手を取り合うことで大きな支援の力になります。'}
      </p>
      <p>
        {currentLang === 'en' ? (
          <>We sincerely look forward to your cooperation and participation.<br />We also appreciate your help in sharing this with friends and at your schools.</>
        ) : (
          <>皆様のご協力・ご参加を心よりお待ちしております。<br />また、周囲の友人や学校等への周知・ご協力もよろしくお願いいたします。</>
        )}
      </p>
    </div>

    <footer class="notice-footer">
      <a href={`/${langParam}`} class="return-btn">
        {currentLang === 'en' ? 'Back to Top' : 'トップページへ戻る'}
      </a>
    </footer>
  </div>
</Layout>

<style>
  /* JYRACレイアウト専用のスタイル指定 */
  .notice-container {
    padding: 10px 0;
  }

  .back-link-wrapper {
    margin-bottom: 20px;
  }

  .back-link {
    color: #5b6779;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #009aa6;
  }

  .notice-header {
    border-bottom: 2px solid rgba(0, 154, 166, 0.15);
    padding-bottom: 20px;
    margin-bottom: 24px;
  }

  .meta-info {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .badge-urgent {
    background: #e53e3e;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 6px;
  }

  .notice-date {
    font-size: 13px;
    color: #5b6779;
    font-weight: 700;
  }

  .notice-title {
    font-size: 22px;
    font-weight: 800;
    color: #002b54;
    margin: 0;
    line-height: 1.4;
  }

  .notice-body {
    color: #2c3e50;
    font-size: 15px;
    line-height: 1.8;
  }

  .notice-body p {
    margin-bottom: 18px;
  }

  .sympathy-box {
    background: #f8fafc;
    border-left: 4px solid #94a3b8;
    padding: 16px;
    border-radius: 8px;
    color: #475569;
    font-size: 14px;
  }

  /* ポスター全体を表示するためのスタイル */
  .notice-image-card {
    width: 100%;
    max-width: 520px;
    margin: 24px auto;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0, 154, 166, 0.2);
    box-shadow: 0 4px 15px rgba(0, 43, 84, 0.08);
    background: #ffffff;
  }

  .notice-image-card img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* 情報ブロック */
  .info-block {
    background: #ffffff;
    border: 1px solid rgba(0, 154, 166, 0.15);
    border-radius: 16px;
    padding: 24px;
    margin: 24px 0;
  }

  .info-block h2 {
    font-size: 16px;
    font-weight: 800;
    color: #002b54;
    margin-top: 0;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgba(0, 154, 166, 0.2);
  }

  .info-block ul {
    margin: 0;
    padding-left: 20px;
    color: #4f5e71;
  }

  .info-block li {
    margin-bottom: 8px;
  }

  .highlight-block {
    background: rgba(0, 154, 166, 0.04);
    border-color: rgba(0, 154, 166, 0.3);
  }

  .detail-item {
    margin-bottom: 16px;
  }

  .detail-item strong {
    color: #002b54;
    display: block;
    margin-bottom: 4px;
  }

  .detail-item p {
    margin: 0;
  }

  .btn-wrapper {
    margin-top: 20px;
  }

  .contact-btn {
    display: inline-block;
    background: #009aa6;
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 24px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .contact-btn:hover {
    background: #00818b;
  }

  .notice-footer {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid rgba(0, 154, 166, 0.15);
    text-align: center;
  }

  .return-btn {
    display: inline-block;
    background: #002b54;
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    padding: 12px 32px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .return-btn:hover {
    background: #0a3d6d;
  }

  @media (max-width: 640px) {
    .notice-title {
      font-size: 18px;
    }
    .notice-image-card {
      max-width: 100%;
    }
    .contact-btn, .return-btn {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
  }
</style>
