---
// ==========================================
// 1. DATA LAYER (Astroフロントマターでデータを一元管理)
// ==========================================
import Layout from '../layouts/Layout.astro';
import { translations, type Lang } from '../lib/i18n';

// URLから言語パラメーターを取得 (プロトコルをhttpsに整形)
const requestUrl = Astro.request.url.replace(/^http:/, 'https:');
const url = new URL(requestUrl);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
const langParam = currentLang === 'en' ? '?lang=en' : '';

// 言語に応じたカードデータ
const CARDS = [
  { id: 1, c: 'dis', txt: currentLang === 'en' ? 'School gymnasium designated as a shelter. Heavy rain and strong winds outside.' : '避難所に指定された学校の体育館。外は激しい雨と風。', e: '⛈️' },
  { id: 2, c: 'dis', txt: currentLang === 'en' ? 'Major earthquake at night. Total blackout across the surrounding area.' : '夜間に大きな地震が発生。周辺一帯が停電している。', e: '🌑' },
  { id: 3, c: 'dis', txt: currentLang === 'en' ? 'Earthquake during a severe midwinter cold wave. Heating is unavailable.' : '真冬の寒波のなか地震が発生。暖房が効かない。', e: '❄️' },
  { id: 4, c: 'dis', txt: currentLang === 'en' ? 'Heavy rain caused by a typhoon. Nearby river level reaches warning status.' : '台風による大雨で、近くの河川の水位が警戒レベルに。', e: '🌊' },
  { id: 5, c: 'time', txt: currentLang === 'en' ? '3 hours after disaster. The first wave of evacuees pours in.' : '発災から「3時間後」。最初の避難者が次々と押し寄せる。', e: '⏳' },
  { id: 6, c: 'time', txt: currentLang === 'en' ? '24 hours after disaster (Day 1). Temporary toilets arrive.' : '発災から「24時間後（1日目）」。仮設トイレが届く。', e: '🌅' },
  { id: 7, c: 'time', txt: currentLang === 'en' ? '3 days (72 hours) after disaster. First shipment of relief supplies arrives.' : '発災から「3日後（72時間）」。救援物資の第一陣が到着。', e: '📅' },
  { id: 8, c: 'fac', txt: currentLang === 'en' ? 'In addition to the gym, 3 classrooms and a multipurpose hall are available.' : '体育館のほか、教室3室と多目的ホールが使用可能。', e: '🏫' },
  { id: 9, c: 'fac', txt: currentLang === 'en' ? 'School water tank is functional; water runs but toilets cannot be flushed.' : '学校の受水槽が生きており、水は出るが流せない。', e: '🚰' },
  { id: 10, c: 'fac', txt: currentLang === 'en' ? 'Found 300 meals of pre-cooked rice and 50 blankets in the emergency storehouse.' : '備蓄倉庫からアルファ米300食と毛布50枚を発見。', e: '📦' },
  { id: 11, c: 'peo', txt: currentLang === 'en' ? 'A mother with an infant looking for a nursing space.' : '乳幼児を連れた母親。授乳スペースを求めている。', e: '👶' },
  { id: 12, c: 'peo', txt: currentLang === 'en' ? 'An elderly person in a wheelchair and their family caregiver.' : '車椅子の高齢者と、そのお世話をする家族。', e: '👨‍🦽' },
  { id: 13, c: 'peo', txt: currentLang === 'en' ? 'A foreign family with limited Japanese skills (2 adults, 1 child).' : '日本語が苦手な外国人の家族（大人2人、子ども1人）。', e: '🗣️' },
  { id: 14, c: 'peo', txt: currentLang === 'en' ? 'An evacuee who arrived with a large pet dog.' : 'ペット（大型犬）を連れて避難してきた飼い主。', e: '🐕' },
  { id: 15, c: 'peo', txt: currentLang === 'en' ? 'A group of 30 high school students on a field trip seeking shelter.' : '修学旅行中の高校生グループ30名が避難を求めてきた。', e: '🎒' }
];

const DISCUSSIONS = {
  t: currentLang === 'en' 
    ? ['Where should manhole or temporary toilets be installed?', 'What rules should determine priority access to toilets?', 'How to assign responsibilities for toilet cleaning and waste disposal?']
    : ['マンホールトイレや仮設トイレをどこに設置するか？', '誰を優先して使ってもらうルールにするか？', 'トイレの清掃やゴミ出しの担当をどう決めるか？'],
  k: currentLang === 'en'
    ? ['Where should soup kitchens and supply distribution points be set up?', 'How to handle evacuees with food allergies or religious restrictions?', 'How to manage and conserve precious water and fuel?']
    : ['炊き出しや物資の配布場所をどこに設けるか？', 'アレルギーや宗教上の配慮が必要な人への対応は？', '貴重な水や燃料をどう管理・節約するか？'],
  b: currentLang === 'en'
    ? ['How to create private spaces while maintaining access pathways?', 'Where to locate beds for the elderly and people with special needs?', 'How to mitigate cold and hard gymnasium floors?']
    : ['通路を確保しつつ、プライベート空間をどう作るか？', '高齢者や要配慮者のベッド位置をどこにするか？', '体育館の床の冷たさや硬さを防ぐ工夫は？']
};

const CH_CARDS = [
  { id: 'ch1', c: 'con', txt: currentLang === 'en' ? 'How to handle communication and information sharing inside the shelter?' : '避難所内の連絡・情報共有をどう行うか？', e: '📢' },
  { id: 'ch2', c: 'con', txt: currentLang === 'en' ? 'How to secure communication lines with external agencies (municipal office, EMS)?' : '外部（役場や救急）との通信手段の確保は？', e: '📱' },
  { id: 'ch3', c: 'sup', txt: currentLang === 'en' ? 'Who should be assigned to sort and manage incoming relief supplies?' : '届いた物資の仕分け・管理の担当者をどうするか？', e: '🤝' },
  { id: 'ch4', c: 'sup', txt: currentLang === 'en' ? 'How to handle interpersonal conflicts among evacuees (noise, pets, etc.)?' : '避難者同士のトラブル（騒音・ペット等）の対応は？', e: '⚡' }
];
---

<Layout 
  title={currentLang === 'en' ? 'HUG Gioco — TKB Evacuation Shelter Management Game' : 'HUG Gioco — TKB型避難所運営ディスカッションゲーム'} 
  currentTab="gioco"
>
  
  <div class="gioco-local-wrapper" id="jyrac-gioco-root">
    
    <header class="game-inner-header">
      <div class="titles-area">
        <b>HUG Gioco</b>
        <span>{currentLang === 'en' ? 'TKB Evacuation Shelter Discussion Game' : 'TKB型避難所運営ディスカッションゲーム'}</span>
      </div>
      <div class="nav-spacer"></div>
      <a href={`/gioco${langParam}`} class="btn-back-to-site">
        {currentLang === 'en' ? '➔ Back to JYRAC Site' : 'JYRACサイトに戻る ➔'}
      </a>
      <div class="step-dots">
        <i id="dot-0" class="on"></i>
        <i id="dot-1"></i>
        <i id="dot-2"></i>
        <i id="dot-3"></i>
        <i id="dot-4"></i>
        <i id="dot-5"></i>
      </div>
    </header>

    <div class="game-views-container">
      <div id="view-0" class="view active">
        <div class="hero">
          <div class="logo-main">
            <div class="logo-h">H</div>
            <div class="logo-u">U</div>
            <div class="logo-g2">G</div>
            <div class="logo-text-gioco">Gioco</div>
          </div>
          <span class="sub">{currentLang === 'en' ? 'TKB Evacuation Shelter Discussion Game' : 'TKB型避難所運営ディスカッションゲーム'}</span>
        </div>

        <p class="desc">
          {currentLang === 'en' ? (
            <>Draw cards and think together about shelter <span class="highlight-text">"challenges"</span>.</>
          ) : (
            <>カードを引いて、避難所の<span class="highlight-text">「困った」</span>をみんなで考えよう。</>
          )}
        </p>

        <div class="setup-box">
          <h3>🎮 {currentLang === 'en' ? 'Game Setup' : 'ゲームをはじめる準備'}</h3>
          
          <div class="setup-group">
            <label>{currentLang === 'en' ? '① Select Number of Players' : '① プレイ人数を選んでください'}</label>
            <div class="radio-tile-group">
              <label class="radio-tile">
                <input type="radio" name="play-mode" value={currentLang === 'en' ? 'Solo (1 Person)' : '1人（個人ワーク）'} checked />
                <span>👤 {currentLang === 'en' ? '1 Player' : '1人'}</span>
              </label>
              <label class="radio-tile">
                <input type="radio" name="play-mode" value={currentLang === 'en' ? '2-4 Players' : '2〜4人グループ'} />
                <span>👥 {currentLang === 'en' ? '2-4 Players' : '2〜4人'}</span>
              </label>
              <label class="radio-tile">
                <input type="radio" name="play-mode" value={currentLang === 'en' ? '5+ Players' : '5人以上のグループ'} />
                <span>🏫 {currentLang === 'en' ? '5+ Players' : '5人以上'}</span>
              </label>
            </div>
          </div>

          <div class="setup-group">
            <label>{currentLang === 'en' ? '② Select Difficulty Level' : '② 難易度を選んでください'}</label>
            <div class="radio-tile-group">
              <label class="radio-tile">
                <input type="radio" name="difficulty" value="easy" />
                <span class="diff-text easy">🔰 {currentLang === 'en' ? 'Easy (Mild)' : '初級 (穏やか)'}</span>
              </label>
              <label class="radio-tile">
                <input type="radio" name="difficulty" value="normal" checked />
                <span class="diff-text normal">⚖️ {currentLang === 'en' ? 'Normal (Standard)' : '中級 (標準)'}</span>
              </label>
              <label class="radio-tile">
                <input type="radio" name="difficulty" value="hard" />
                <span class="diff-text hard">🚨 {currentLang === 'en' ? 'Hard (Severe)' : '上級 (修羅場)'}</span>
              </label>
            </div>
          </div>

          <div style="text-align: center; margin-top: 30px;">
            <button id="btn-start-game" class="game-btn big sun" type="button">
              🚀 {currentLang === 'en' ? 'Start Game' : 'ゲームを開始する'}
            </button>
          </div>
        </div>
      </div>

      <div id="view-1" class="view">
        <div class="screen-head">
          <h2>{currentLang === 'en' ? 'STEP 1: Generate Shelter Scenario' : 'STEP 1: 避難所の状況を生成する'}</h2>
        </div>
        <p class="desc">
          {currentLang === 'en'
            ? 'Click "Draw Cards" to randomly determine your assigned shelter conditions.'
            : '「カードを引く」ボタンを押すと、あなたが割り当てられた避難所の環境がランダムに決定します。'}
        </p>

        <div class="tkb-badge-row">
          <span class="tkb-badge t">🚾 T: Toilet ({currentLang === 'en' ? 'Sanitation' : 'トイレ対策'})</span>
          <span class="tkb-badge k">🍳 K: Kitchen ({currentLang === 'en' ? 'Food & Water' : '食事・炊き出し'})</span>
          <span class="tkb-badge b">🛏️ B: Bed ({currentLang === 'en' ? 'Comfort & Living' : '快適な睡眠・居住'})</span>
        </div>

        <div style="text-align: center; margin: 28px 0 20px;">
          <button id="btn-draw" class="game-btn big" type="button">
            🎲 {currentLang === 'en' ? 'Draw Cards to Create Scenario' : 'カードを引いて状況を作る'}
          </button>
        </div>

        <div id="sit-cards" class="cards"></div>

        <div style="text-align: center; margin-top: 40px;">
          <button id="btn-next-step1" class="game-btn green" type="button" disabled>
            {currentLang === 'en' ? 'Next Step (Discussion) ➔' : '次へ進む（課題検討） ➔'}
          </button>
        </div>
      </div>

      <div id="view-2" class="view">
        <div class="screen-head">
          <h2>{currentLang === 'en' ? 'STEP 2: Tackle TKB Challenges' : 'STEP 2: TKBの課題に向き合う'}</h2>
          <span class="tag">{currentLang === 'en' ? 'Group Work' : 'グループワーク'}</span>
        </div>

        <div class="situation">
          <div class="lbl">{currentLang === 'en' ? 'Current Scenario Setup' : '現在のシチュエーション設定'}</div>
          <p id="step2-sit-text"></p>
        </div>

        <div class="note-line">
          💡 {currentLang === 'en' 
            ? <>Discuss <b>what problems might occur and how to respond</b> for each T, K, and B question below.</>
            : <>下記の<b>T・K・Bそれぞれの問い</b>について、「何が問題になるか」「どう対応するか」を話し合ってみましょう。</>}
        </div>

        <div id="q-cards-box" class="q-groups"></div>

        <div class="section-label">
          <span class="pill">{currentLang === 'en' ? 'Notes' : '記録メモ'}</span> 
          {currentLang === 'en' ? 'Note down insights and ideas during the session' : 'ワーク中の気づきや意見をメモしよう'}
        </div>

        <div class="memo-grid">
          <div class="memo m1">
            <label>{currentLang === 'en' ? '① Expected challenges in this situation?' : '① 今回の状況で「想定される課題」は？'}</label>
            <textarea data-memo="issues" placeholder={currentLang === 'en' ? 'e.g., Blackout makes nighttime toilets dangerous; 50 blankets are far too few for the number of evacuees.' : '例：停電しているので夜間のトイレが非常に危険、物資の毛布50枚に対して避難者が多すぎる、など'}></textarea>
          </div>
          <div class="memo m2">
            <label>{currentLang === 'en' ? '② Who needs special consideration?' : '② 「特に配慮が必要な人」は誰？'}</label>
            <textarea data-memo="care" placeholder={currentLang === 'en' ? 'e.g., Multilingual signs for foreign families; quiet private room for nursing mothers and infants.' : '例：日本語が不慣れな外国人家族への案内掲示、乳幼児の泣き声や授乳のための個室教室の割り当て、など'}></textarea>
          </div>
        </div>

        <div class="final-actions">
          <button id="btn-back-step2" class="game-btn ghost small" type="button">
            🔀 {currentLang === 'en' ? 'Redraw Scenario' : '状況を引き直す'}
          </button>
          <button id="btn-next-step2" class="game-btn green" type="button">
            {currentLang === 'en' ? 'Next Step (Check Incident) ➔' : '次へ進む（アクシデント発生確認） ➔'}
          </button>
        </div>
      </div>

      <div id="view-3" class="view">
        <div class="screen-head">
          <h2>{currentLang === 'en' ? 'STEP 3: Sudden Incident & Management Issue' : 'STEP 3: 突然のアクシデント・運営課題'}</h2>
          <span id="incident-tag" class="tag" style="background:#fde3e5; color:var(--red);">{currentLang === 'en' ? 'Incident Response' : 'トラブル対応'}</span>
        </div>

        <div id="incident-alert" class="note-line" style="background:#fde3e5; border-color:var(--red); color:var(--red-deep);">
          ⚠️ <b>{currentLang === 'en' ? 'Additional Challenge!' : '追加チャレンジ発生！'}</b> 
          {currentLang === 'en' 
            ? ' As discussion progressed, an additional incident occurred. How will you overcome this?' 
            : ' 運営ディスカッションを進める中、さらに以下のアクシデントが発生しました。どう乗り越えますか？'}
        </div>

        <div id="ch-cards-box" class="cards"></div>

        <div class="memo-grid">
          <div class="memo m3">
            <label>{currentLang === 'en' ? '③ Immediate actions needed to prevent confusion?' : '③ 混乱を防ぐために「今すぐ必要な対応」は？'}</label>
            <textarea data-memo="now" placeholder={currentLang === 'en' ? 'e.g., Organize energetic student volunteers to assist with supply unloading and waste management.' : '例：修学旅行中の元気な高校生たちに物資搬入やゴミ集積の手伝いチームを結成してもらう、など'}></textarea>
          </div>
          <div class="memo m4">
            <label>{currentLang === 'en' ? '④ What should be prepared in advance?' : '④ 普段の生活から「事前に準備すべきこと」は？'}</label>
            <textarea data-memo="prep" placeholder={currentLang === 'en' ? 'e.g., Review school emergency stockpiles; conduct regular disaster drills.' : '例：学校の備蓄品見直し、防災訓練の実施など'}></textarea>
          </div>
        </div>

        <div class="final-actions">
          <button id="btn-back-step3" class="game-btn ghost small" type="button">
            ⬅ {currentLang === 'en' ? 'Back' : '戻る'}
          </button>
          <button id="btn-next-step3" class="game-btn green" type="button">
            {currentLang === 'en' ? 'Complete Sheet! ➔' : 'シートをまとめて完成！ ➔'}
          </button>
        </div>
      </div>

      <div id="view-4" class="view">
        <div class="screen-head">
          <h2>{currentLang === 'en' ? 'HUG Gioco Worksheet Record' : 'HUG Gioco ワーク記録シート'}</h2>
        </div>
        <div class="review-box">
          <div class="r-item">
            <h5>{currentLang === 'en' ? 'Scenario Settings' : '設定シチュエーション'}</h5>
            <div id="rSit" class="content"></div>
          </div>
          <div class="r-item">
            <h5>{currentLang === 'en' ? 'Q1. Expected Challenges in this Scenario' : 'Q1. 今回の状況で「想定される課題」'}</h5>
            <div class="content" data-r="issues"></div>
          </div>
          <div class="r-item">
            <h5>{currentLang === 'en' ? 'Q2. Insights for Special Considerations' : 'Q2. 「特に配慮が必要な人」への気づき'}</h5>
            <div class="content" data-r="care"></div>
          </div>
          <div class="r-item">
            <h5>{currentLang === 'en' ? 'Q3. Immediate Response to Prevent Confusion' : 'Q3. トラブルを防ぐために「今すぐ必要な対応」'}</h5>
            <div class="content" data-r="now"></div>
          </div>
          <div class="r-item">
            <h5>{currentLang === 'en' ? 'Q4. Advance Preparations & Stockpiles' : 'Q4. 防災のために「事前に準備・備蓄すべきこと」'}</h5>
            <div class="content" data-r="prep"></div>
          </div>
          
          <div class="r-item">
            <h5>{currentLang === 'en' ? 'Q5. Reflections, Feedback & Community Ideas' : 'Q5. 感想・振り返り、または地域へのアイデア'}</h5>
            <div class="memo m5" style="border:none; padding:0; box-shadow:none;">
              <textarea data-memo="propose" placeholder={currentLang === 'en' ? 'e.g., Reflections after playing, ideas to apply to local disaster training, etc.' : '例：プレイしてみた感想や、地域の防災訓練に活かせるアイデアなど'} style="min-height:100px; margin-top:8px;"></textarea>
            </div>
          </div>
        </div>
        
        <div class="final-actions">
          <button id="btn-back-step4" class="game-btn ghost small" type="button">
            ⬅ {currentLang === 'en' ? 'Edit' : '修正する'}
          </button>
          <button id="btn-copy" class="game-btn sun" type="button">
            📋 {currentLang === 'en' ? 'Copy Text' : 'テキストコピー'}
          </button>
          <button id="btn-print" class="game-btn sky" type="button">
            🖨️ {currentLang === 'en' ? 'Print A4' : 'A4用紙に印刷'}
          </button>
          <button id="btn-submit-sheet" class="game-btn green" type="button">
            ☁️ {currentLang === 'en' ? 'Submit to Sheet & Finish' : '管理シートに記録して終了'}
          </button>
          <button id="btn-restart" class="game-btn red" type="button">
            🔄 {currentLang === 'en' ? 'Restart Game' : '最初からやり直す'}
          </button>
        </div>
        <div class="footer-note">
          <b>HUG Gioco</b> — {currentLang === 'en' ? 'TKB Evacuation Shelter Discussion Game' : 'TKB型避難所運営ディスカッションゲーム'}<br>
          {currentLang === 'en' ? 'Supported by Japan Youth Resilience Action Consortium (JYRAC)' : '協力：日本若者防災復興協会（JYRAC）'}
        </div>
      </div>

      <div id="view-5" class="view">
        <div class="success-screen">
          <div class="success-icon">✨</div>
          <h2>{currentLang === 'en' ? 'Worksheet Submitted!' : 'ワークシート送信完了！'}</h2>
          <p class="success-msg">
            {currentLang === 'en'
              ? 'Your data has been successfully recorded in the PR management spreadsheet.\nThank you for your valuable feedback and discussion records!'
              : 'データは広報局の管理スプレッドシートに正常に記録されました。\n貴重なご意見・ディスカッションの記録をありがとうございます！'}
          </p>
          
          <div class="submitted-summary-box">
            <h4>📥 {currentLang === 'en' ? 'Submission Summary' : '送信内容のサマリー'}</h4>
            <div class="summary-item"><strong>{currentLang === 'en' ? 'Mode / Difficulty:' : 'モード / 難易度:'}</strong> <span id="s-meta"></span></div>
            <div class="summary-item"><strong>{currentLang === 'en' ? 'Scenario:' : 'シチュエーション:'}</strong> <div id="s-sit" class="sum-content"></div></div>
            <div class="summary-item"><strong>{currentLang === 'en' ? 'Reflections / Proposals:' : '感想・提案:'}</strong> <div id="s-prop" class="sum-content"></div></div>
          </div>

          <div style="text-align: center; margin-top: 35px;">
            <button id="btn-finish-restart" class="game-btn big sun" type="button">
              🔄 {currentLang === 'en' ? 'Play New Game Again' : 'もう一度新しくゲームを遊ぶ'}
            </button>
          </div>
        </div>
        <div class="footer-note">
          <b>HUG Gioco</b> — {currentLang === 'en' ? 'TKB Evacuation Shelter Discussion Game' : 'TKB型避難所運営ディスカッションゲーム'}<br>
          {currentLang === 'en' ? 'Supported by Japan Youth Resilience Action Consortium (JYRAC)' : '協力：日本若者防災復興協会（JYRAC）'}
        </div>
      </div>

    </div>
  </div>

  <div id="game-scoped-toast" class="game-scoped-toast"></div>
</Layout>

{/* ==========================================
// 3. SCOPED STYLE LAYER
// ========================================== */}
<style>
  .gioco-local-wrapper {
    --navy: #1B3A8C; --navy-deep: #152E70; --green: #2E9E4F; --green-deep: #1f7d3c; --red: #E01E2B; --red-deep: #b8161f;
    --white: #FFFFFF; --sky: #4AA9E0; --sky-soft: #DDEEFA; --sun: #FFD23F; --sun-soft: #FFF3C9; --cream: #FDFBF5; --cream-2: #F5F0E4;
